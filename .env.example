#######################################
# SOLARYA TRAVEL - CONFIGURAZIONE
# Copia questo file in .env e configura
#######################################

APP_NAME="Solarya Travel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Rome
APP_URL=https://solaryatravel:8890
# Host del canale B2B agenzie (secondo document root: cartella /b2b).
# In locale include la porta; in produzione il dominio puro (b2b.solaryatravel.com).
B2B_HOST=b2b.solaryatravel:8890
# SESSION_DOMAIN deve restare VUOTO: cookie host-only, sessioni separate main/b2b.

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

#######################################
# DATABASE - MAMP MySQL
#######################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=8889
DB_DATABASE=solaryatravel
DB_USERNAME=genericUsr
DB_PASSWORD=Password08$
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

#######################################
# CACHE & SESSION
#######################################
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

QUEUE_CONNECTION=sync

#######################################
# MAIL - Locale
#######################################
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@solaryatravel.com"
MAIL_FROM_NAME="${APP_NAME}"

#######################################
# STRIPE - TEST MODE
#######################################
STRIPE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

#######################################
# FILE STORAGE
#######################################
FILESYSTEM_DISK=public

#######################################
# LOGGING
#######################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#######################################
# TELESCOPE (Dev only)
#######################################
TELESCOPE_ENABLED=true

#######################################
# BOOKING SETTINGS
#######################################
BOOKING_PENDING_EXPIRY_MINUTES=30
BOOKING_ADVANCE_HOURS=24
BOOKING_MAX_DAYS_AHEAD=180
BOOKING_TAX_RATE=0

#######################################
# QR CODE
#######################################
QR_CODE_SIZE=300
QR_CODE_STORAGE=public

#######################################
# TRACCIAMENTO E ANALISI (cookie banner)
# Gli script si caricano solo previo consenso dell'utente.
# Lasciare vuoto un ID disattiva il relativo strumento.
#
# ATTIVO SOLO IN PRODUZIONE (APP_ENV=production): in locale/staging non viene
# emesso nessun tag, così le visite di sviluppo non falsano le statistiche.
# Per forzare una prova fuori produzione: TRACKING_ENABLED=true
#######################################
# TRACKING_ENABLED=true
# Google Tag Manager (GTM-XXXXXXX) — contenitore consigliato per GA4 + Pixel
GTM_ID=GTM-MKQLNHZ7
# Google Analytics 4 (G-XXXXXXXXXX) — usare solo se NON gestito tramite GTM
GOOGLE_ANALYTICS_ID=
# Meta/Facebook Pixel (ID numerico) — usare solo se NON gestito tramite GTM
META_PIXEL_ID=
# Google Search Console — token del meta tag di verifica (non è un cookie)
GOOGLE_SITE_VERIFICATION=

#######################################
# VITE (Development)
#######################################
VITE_APP_NAME="${APP_NAME}"
