APP_NAME="Solarya Travel"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://solaryatravel:8890
B2B_HOST=b2b.solaryatravel:8890

APP_LOCALE=it
APP_FALLBACK_LOCALE=en

# I test usano un database MySQL dedicato (NON SQLite): le migrazioni usano
# ALTER TABLE ... ENUM, non supportato da SQLite. Crea il DB una volta:
#   CREATE DATABASE solaryatravel_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# poi:  php artisan migrate --env=testing
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=solaryatravel_test
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BCRYPT_ROUNDS=4
